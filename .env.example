# ==========================================
# 1. Credenciais da API Yampi
# ==========================================
# Token de usuário gerado no painel da Yampi
YAMPI_USER_TOKEN="seu_token_aqui"

# Chave secreta do usuário gerada no painel da Yampi
YAMPI_USER_SECRET_KEY="sua_chave_secreta_aqui"

# Alias/subdomínio único da sua loja na Yampi (ex: minhaloja)
YAMPI_ALIAS="nome_da_sua_loja"

# ==========================================
# 2. Observabilidade, Logs e Monitoramento
# ==========================================
# Nível detalhado de logs (1 para ativado - DEBUG, 0 para desativado - INFO)
VERBOSE="1"


# ==========================================
# 3. Servidor SMTP Principal (Envio aos Clientes)
# ==========================================
# Usuário/E-mail de autenticação do servidor SMTP para envio de comunicações de vendas aos clientes
SMTP_USER="seu_email@gmail.com"

# Senha de aplicativo ou senha do usuário SMTP principal
SMTP_PASSWORD="sua_senha_de_app"

# Host do servidor SMTP (ex: smtp.gmail.com, smtp.sendgrid.net, etc)
SMTP_HOST="smtp.gmail.com"

# Porta do servidor SMTP (587 para TLS com STARTTLS, 465 para SSL direto)
SMTP_PORT="587"

# Endereço de e-mail remetente que aparecerá no cabeçalho dos e-mails enviados aos clientes
SMTP_FROM="seu_email@gmail.com"

# ==========================================
# 4. Servidor SMTP Dedicado para Alerta de Erros / Traceback
# ==========================================
# Usuário/E-mail do servidor SMTP independente dedicado EXCLUSIVAMENTE ao envio de alertas de erro/crash
TRACEBACK_SMTP_USER="seu_email_alerta@gmail.com"

# Senha de aplicativo ou senha do usuário SMTP de alerta de erros
TRACEBACK_SMTP_PASSWORD="sua_senha_de_app_alerta"

# Host do servidor SMTP dedicado a notificações de erro
TRACEBACK_SMTP_HOST="smtp.gmail.com"

# Porta do servidor SMTP de notificações de erro (587 para TLS, 465 para SSL)
TRACEBACK_SMTP_PORT="587"

# E-mail remetente que figurará no envio do alerta de erro
TRACEBACK_SMTP_FROM="seu_email_alerta@gmail.com"

# E-mail de destino (SEU e-mail pessoal/técnico) que receberá o aviso de crash com o log em anexo
TRACEBACK_EMAIL_RECIPIENT="seu_email_pessoal@gmail.com"

# DSN do Sentry para rastreamento de exceções e erros em nuvem (opcional)
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"


# ==========================================
# 5. Banco de Dados PostgreSQL
# ==========================================
# Usuário de acesso ao banco de dados relacional PostgreSQL
DB_USER="db_user"

# Senha do usuário do banco de dados
DB_PASSWORD="user_password"

# Nome do banco de dados relacional
DB_NAME="db_name"

# String de conexão completa com o banco PostgreSQL (utilizada em produção)
DATABASE_URL="postgresql://user:senha@localhost:5432/db"