# Credenciais da Yampi (Substitua pelos seus dados reais)
YAMPI_USER_TOKEN=seu_token_aqui
YAMPI_USER_SECRET_KEY=sua_chave_secreta_aqui
YAMPI_ALIAS=nome_da_sua_loja

VERBOSE=1 

# Configurações SMTP (Se em produção)
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=seu_email@gmail.com

DB_USER="db_user"
DB_PASSWORD="user_password"
DB_NAME="db_name"
DATABASE_URL="user://user:senha@localhost:5432/db"