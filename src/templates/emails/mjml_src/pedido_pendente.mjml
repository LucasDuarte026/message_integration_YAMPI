<mjml>
  <mj-head>
    <mj-title>Seu Pedido foi Reservado - Conclua o Pagamento!</mj-title>
    <mj-include path="./components/styles.mjml" />
  </mj-head>

  <mj-body background-color="#F8FAFC">
    <mj-wrapper css-class="content-card" padding="0">
      
      <!-- Cabeçalho (Header) - Imagem Fina no Topo -->
      <mj-include path="./components/header.mjml" />
      
      <!-- Introdução (Body) -->
      <mj-section background-color="#FFFFFF" padding="30px 20px 10px 20px">
        <mj-column width="100%">
          
          <mj-text font-size="24px" font-weight="bold" color="#1E3A8A" align="center" padding-bottom="10px">
            Seu pedido foi reservado! ⏳
          </mj-text>
          
          <mj-text font-size="16px" color="#334155" line-height="150%" align="center" padding-bottom="15px">
            Olá, <strong>{{ customer_name | default('Cliente') }}</strong>! O seu pedido <strong>{{ order_number | default('#0000') }}</strong> foi gerado com sucesso em nosso sistema.
          </mj-text>

        </mj-column>
      </mj-section>

      <!-- CARD CINZA CONTINUO COM IMAGEM TOUCHING BORDERS (Estilo Referência) -->
      <mj-section background-color="#FFFFFF" padding="0px 20px 20px 20px">
        <mj-column width="100%" background-color="#F1F5F9" border-radius="16px">
          
          <!-- Imagem Central Expandida tocando as bordas superiores do Card -->
          <mj-image src="{{ body_image_url | default('https://via.placeholder.com/600x400/1E3A8A/FFFFFF?text=Aguardando+Pagamento') }}" alt="Aguardando Pagamento" padding="0" width="600px" border-radius="16px 16px 0 0" />
          
          <!-- Conteúdo Interno do Card Cinza Conectado à Imagem -->
          <mj-text align="center" font-size="20px" font-weight="bold" color="#1E3A8A" padding="25px 20px 8px 20px">
            Falta pouco para garantir seus produtos!
          </mj-text>

          <mj-text align="center" font-size="15px" color="#475569" line-height="150%" padding="0px 25px 15px 25px">
            Conclua o pagamento agora para que a nossa equipe possa separar e despachar o seu pacote o quanto antes.
          </mj-text>

          <mj-raw>{% if pix_code %}</mj-raw>
          <!-- Bloco do PIX Copia e Cola Moderno (Pontilhado) -->
          <mj-text align="center" padding="0px 20px 20px 20px">
            <div style="background-color: #ffffff; padding: 16px; border-radius: 12px; text-align: center; border: 1px solid #E2E8F0; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
              <span style="color: #64748b; font-size: 13px; font-weight: bold; display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Chave PIX Copia e Cola:</span>
              <span style="color: #94A3B8; font-size: 12px; display: block; margin-bottom: 12px;">Pressione e segure o código abaixo para copiar:</span>
              <div style="background-color: #F8FAFC; padding: 14px; border-radius: 8px; border: 1px dashed #10B981;">
                <strong style="color: #10B981; font-size: 13px; font-family: monospace; word-break: break-all; display: block; line-height: 1.5; user-select: all;">{{ pix_code }}</strong>
              </div>
            </div>
          </mj-text>
          <mj-raw>{% else %}</mj-raw>
          <!-- Botão Moderno Pill-Shape (Para outros meios de pagamento) -->
          <mj-button css-class="btn-shadow-blue" href="{{ checkout_url | default('https://elevemeloja.com.br') }}" background-color="#1E3A8A" color="#FFFFFF" border-radius="28px" font-size="16px" font-weight="bold" padding="10px 0 25px 0" inner-padding="14px 36px">
            Finalizar Pagamento
          </mj-button>
          <mj-raw>{% endif %}</mj-raw>

        </mj-column>
      </mj-section>

      <!-- Tabela de Produtos Comprados -->
      {% if items_html %}
      <mj-section background-color="#FFFFFF" padding="0px 20px 20px 20px">
        <mj-column width="100%">
          <mj-text font-size="16px" font-weight="bold" color="#1E3A8A" padding-bottom="10px">
            Itens do Pedido:
          </mj-text>
          <mj-raw>
            <table width="100%" style="border-collapse: collapse; background-color: #F8FAFC; border-radius: 8px; overflow: hidden;">
              <thead>
                <tr style="background-color: #E2E8F0; text-align: left;">
                  <th style="padding: 10px; font-family: sans-serif; font-size: 13px; color: #475569;">Item</th>
                  <th style="padding: 10px; font-family: sans-serif; font-size: 13px; color: #475569; text-align: center;">Quantidade</th>
                  <th style="padding: 10px; font-family: sans-serif; font-size: 13px; color: #475569; text-align: right;">Preço</th>
                </tr>
              </thead>
              <tbody>
                {{ items_html | safe }}
              </tbody>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>
      {% endif %}

      <!-- Disclaimer de Expiração / Aprovação PIX -->
      <mj-section background-color="#FFFFFF" padding="0px 20px 25px 20px">
        <mj-column width="100%">
          <mj-text font-size="13px" color="#64748B" line-height="150%" align="center" padding="0px 10px">
            ⚠️ <em>Os produtos ficam reservados temporariamente. Pagamentos via PIX possuem aprovação e confirmação imediata!</em>
          </mj-text>
          
          <mj-text font-size="14px" color="#64748B" line-height="150%" align="center" padding-top="20px">
            Se você tiver qualquer dúvida, nossa equipe de suporte está à disposição.
          </mj-text>
        </mj-column>
      </mj-section>
      
      <!-- Footer -->
      <mj-include path="./components/footer.mjml" />

    </mj-wrapper>
  </mj-body>
</mjml>
