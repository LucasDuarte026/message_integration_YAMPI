<mjml>
  <mj-head>
    <mj-title>Ganhe {{ value_cupom }}% OFF no seu Pedido!</mj-title>
    <mj-include path="../layouts/components/styles.mjml" />
  </mj-head>

  <mj-body background-color="#F8FAFC">
    <mj-wrapper css-class="content-card" padding="0">
      
      <!-- Cabeçalho (Header) - Imagem Fina no Topo -->
      <mj-include path="../layouts/components/header.mjml" />
      
      <!-- Introdução (Body) -->
      <mj-section background-color="#FFFFFF" padding="30px 20px 10px 20px">
        <mj-column width="100%">
          
          <mj-text font-size="24px" font-weight="bold" color="#1E3A8A" align="center" padding-bottom="10px">
            Um presente especial para você! 🎁
          </mj-text>
          
          <mj-text font-size="16px" color="#334155" line-height="150%" align="center" padding-bottom="15px">
            Olá, <strong>{{ customer_name | default('Cliente') }}</strong>! Vimos que você escolheu produtos incríveis na Eleveme. Para dar aquele empurrãozinho final, liberamos <strong>{{ value_cupom }}% de desconto exclusivo</strong> no seu pedido!
          </mj-text>

        </mj-column>
      </mj-section>

      <!-- CARD CINZA CONTINUO COM IMAGEM TOUCHING BORDERS -->
      <mj-section background-color="#FFFFFF" padding="0px 20px 20px 20px">
        <mj-column width="100%" background-color="#F1F5F9" border-radius="16px">
          
          <!-- Imagem Central Expandida tocando as bordas superiores do Card -->
          <mj-image src="{{ body_image_url | default('https://via.placeholder.com/600x400/10B981/FFFFFF?text={{ value_cupom }}%25+OFF') }}" alt="{{ value_cupom }}% OFF" padding="0" width="600px" border-radius="16px 16px 0 0" />
          
          <!-- Conteúdo Interno do Card Cinza -->
          <mj-text align="center" font-size="20px" font-weight="bold" color="#1E3A8A" padding="25px 20px 10px 20px">
            Seu Cupom de {{ value_cupom }}% Desconto ✨
          </mj-text>

          <!-- CAIXA PONTILHADA ESTILO ANTIGO COM SOMBRA -->
          <mj-text align="center" padding="0px 20px 20px 20px">
            <div style="background-color: #ffffff; padding: 18px; border-radius: 10px; text-align: center; border: 2px dashed #10b981; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);">
              <span style="color: #64748b; font-size: 14px; display: block; margin-bottom: 6px; font-weight: 500;">Use o cupom:</span>
              <strong style="color: #10b981; font-size: 26px; letter-spacing: 2px; font-family: monospace; display: block;">{{ coupon_code | default('ELEVE10') }}</strong>
            </div>
          </mj-text>

          <!-- Botão Moderno Pill-Shape -->
          <mj-button css-class="btn-shadow" href="{{ store_url | default('https://elevemeloja.com.br') }}" background-color="#10B981" color="#FFFFFF" border-radius="28px" font-size="16px" font-weight="bold" padding="5px 0 25px 0" inner-padding="14px 36px">
            Garantir {{ value_cupom }}% de Desconto
          </mj-button>

        </mj-column>
      </mj-section>

      <!-- Disclaimer -->
      <mj-section background-color="#FFFFFF" padding="0px 20px 25px 20px">
        <mj-column width="100%">
          <mj-text font-size="13px" color="#64748B" line-height="150%" align="center">
            ⚠️ <em>Cupom de uso único por tempo limitado. Aproveite antes que a reserva dos seus produtos seja cancelada!</em>
          </mj-text>
          
          <mj-text font-size="14px" color="#64748B" line-height="150%" align="center" padding-top="20px">
            Se você tiver qualquer dúvida, nossa equipe de suporte está à disposição.
          </mj-text>
        </mj-column>
      </mj-section>
      
      <!-- Footer -->
      <mj-include path="../layouts/components/footer.mjml" />

    </mj-wrapper>
  </mj-body>
</mjml>
